    {
      "name": "2. Documents Core & MVP Upload",
      "item": [
        {
          "name": "TC_DOC_001 - Upload tài liệu PDF multipart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response has success true\", function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "});",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.environment.set(\"docId\", jsonData.data.id);",
                  "}",
                  "if (jsonData.data && jsonData.data.previewIpfsCid) {",
                  "    pm.environment.set(\"previewIpfsCid\", jsonData.data.previewIpfsCid);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "10000000-0000-0000-0000-000000000001",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Bài giảng Lập trình Hướng đối tượng nâng cao",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Tài liệu mẫu thực hành OOP và Design Patterns",
                  "type": "text"
                },
                {
                  "key": "unlockPointsRequired",
                  "value": "10",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{documentServiceUrl}}/api/documents",
              "host": ["{{documentServiceUrl}}"],
              "path": ["api", "documents"]
            }
          },
          "response": []
        },
        {
          "name": "TC_DOC_002 - Xem chi tiết tài liệu khi chưa mở khóa (Anti-Bypass Freemium)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Full ipfsCid is masked and hasUnlocked is false\", function () {",
                  "    pm.expect(jsonData.data.hasUnlocked).to.eql(false);",
                  "    pm.expect(jsonData.data.ipfsCid).to.be.null;",
                  "    pm.expect(jsonData.data.previewIpfsCid).to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "99999999-9999-9999-9999-999999999999",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{documentServiceUrl}}/api/documents/{{docId}}",
              "host": ["{{documentServiceUrl}}"],
              "path": ["api", "documents", "{{docId}}"]
            }
          },
          "response": []
        },
        {
          "name": "TC_DOC_003 - Lấy danh sách feed phân trang",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Feed content is array\", function () {",
                  "    pm.expect(Array.isArray(jsonData.data.content)).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{documentServiceUrl}}/api/documents?page=0&size=10&filter=latest",
              "host": ["{{documentServiceUrl}}"],
              "path": ["api", "documents"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "filter", "value": "latest" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC_DOC_004 - Ghi nhận lượt xem tài liệu",
          "request": {
