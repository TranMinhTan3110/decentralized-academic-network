    {
      "name": "7. Notifications & Admin Moderation",
      "item": [
        {
          "name": "TC_DOC_020_Notifications - GET /api/v1/notifications - Danh sách thông báo người dùng",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "var res = pm.response.json();",
                  "if (res.data && res.data.length > 0) { pm.environment.set(\"notificationId\", res.data[0].id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{testUserId}}", "type": "text" }
            ],
            "url": {
              "raw": "{{documentServiceUrl}}/api/v1/notifications",
              "host": ["{{documentServiceUrl}}"],
              "path": ["api", "v1", "notifications"]
            }
          }
        },
        {
          "name": "TC_DOC_021_Read_Notification - PUT /api/v1/notifications/:id/read - Đánh dấu 1 thông báo là đã đọc",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.variables.get(\"notificationId\") || pm.variables.get(\"notificationId\") === \"\") {",
                  "    pm.variables.set(\"notificationId\", \"00000000-0000-0000-0000-000000000000\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 404\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-User-Id", "value": "{{testUserId}}", "type": "text" }
            ],
            "url": {
              "raw": "{{documentServiceUrl}}/api/v1/notifications/{{notificationId}}/read",
              "host": ["{{documentServiceUrl}}"],
              "path": ["api", "v1", "notifications", "{{notificationId}}", "read"]
            }
          }
        },
