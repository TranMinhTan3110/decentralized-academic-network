    {
      "name": "TC_AI_019 Validate Document Empty Text -> 200 OK (FLAGGED)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"document_id\": \"99999999-9999-9999-9999-999999999999\",\n  \"raw_text\": \"Vài chữ ngắn ngủi không đủ nội dung học thuật.\"\n}"
        },
        "url": {
          "raw": "{{aiServiceUrl}}/api/v1/documents/validate",
          "host": ["{{aiServiceUrl}}"],
          "path": ["api", "v1", "documents", "validate"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Flagged as BLANK_OR_POOR_QUALITY', function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.data.is_valid).to.be.false;",
              "    pm.expect(res.data.status).to.eql('FLAGGED');",
              "    pm.expect(res.data.flag_code).to.eql('BLANK_OR_POOR_QUALITY');",
              "});"
            ]
          }
        }
      ]
