{
  "info": {
    "name": "DeDocu - Recommendation & AI Service",
    "description": "Postman Automated API Test Suite for Recommendation & AI Service (Python FastAPI Port 8000). Covers 22 Test Cases matching Excel specification 1-to-1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC_AI_001 Get Personalized Recommendations -> 200 OK",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearerToken}}"
          }
        ],
        "url": {
          "raw": "{{aiServiceUrl}}/api/v1/recommendations/me?major=Software%20Engineering&limit=5",
          "host": ["{{aiServiceUrl}}"],
          "path": ["api", "v1", "recommendations", "me"],
          "query": [
            { "key": "major", "value": "Software Engineering" },
            { "key": "limit", "value": "5" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('ApiResponse envelope success=true', function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.success).to.be.true;",
              "    pm.expect(res.data.items).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "TC_AI_002 Get Recommendations Missing Token -> 401 Unauthorized",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{aiServiceUrl}}/api/v1/recommendations/me?limit=5",
          "host": ["{{aiServiceUrl}}"],
          "path": ["api", "v1", "recommendations", "me"],
          "query": [{ "key": "limit", "value": "5" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 401 Unauthorized', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test('Error message notifies missing bearer token', function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.success).to.be.false;",
              "    pm.expect(res.message).to.include('Header Authorization');",
              "});"
            ]
          }
        }
      ]
    },
