    {
      "name": "TC_FOLLOW_002 Get Suggested Users to Follow -> 200 OK",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{userServiceUrl}}/api/v1/users/suggested?limit=5",
          "host": [
            "{{userServiceUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "users",
            "suggested"
          ],
          "query": [
            {
              "key": "limit",
              "value": "5"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Suggested users list returned', function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.success).to.be.true;",
              "    pm.expect(Array.isArray(res.data)).to.be.true;",
              "    if (res.data.length > 0) {",
              "        const user = res.data[0];",
              "        pm.expect(user).to.have.property('id');",
              "        pm.expect(user).to.have.property('username');",
              "        pm.expect(user).to.have.property('fullName');",
              "    }",
              "});"
            ]
          }
        }
      ]
