    {
      "name": "TC_AUTH_006 Login successfully with Email -> 200 OK & JWT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"tan.tranminh@dedocu.vn\",\n  \"password\": \"Password@123\"\n}"
        },
        "url": {
          "raw": "{{userServiceUrl}}/api/v1/auth/login",
          "host": [
            "{{userServiceUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returns valid JWT accessToken', function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.data.accessToken).to.be.a('string');",
              "    pm.expect(res.data.tokenType).to.eql('Bearer');",
              "    pm.environment.set('authToken', res.data.accessToken);",
              "    if (res.data.user && (res.data.user.role === 'ADMIN' || res.data.user.role === 'ROLE_ADMIN')) {",
              "        pm.environment.set('adminToken', res.data.accessToken);",
              "    }",
              "    if (res.data.user && res.data.user.id) {",
              "        pm.environment.set('testUserId', res.data.user.id);",
              "        pm.environment.set('userId', res.data.user.id);",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
