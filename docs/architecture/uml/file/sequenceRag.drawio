      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Sequence_RAG_Chat\nactor User\nparticipant \&quot;Next.js Client\&quot; as Client\nparticipant \&quot;API Gateway\&quot; as Gateway\nparticipant \&quot;RAG Chat Service\&quot; as ChatSvc\nparticipant \&quot;Redis\\n(Rate-limit Bucket)\&quot; as Redis\nqueue \&quot;RabbitMQ\\n(Gemini Call Queue)\&quot; as MQ\ndatabase \&quot;Vector DB\&quot; as VectorDB\nparticipant \&quot;Gemini API\&quot; as Gemini\ndatabase \&quot;PostgreSQL\&quot; as PG\n\nUser -&gt; Client : Nhập câu hỏi trong Chat Session\nClient -&gt; Gateway : POST /chat/{session_id}/messages\\n{question}\nGateway -&gt; ChatSvc : forward (đã auth)\n\nChatSvc -&gt; PG : INSERT Chat_Messages\\n(role=&#39;user&#39;, content=question)\n\nChatSvc -&gt; VectorDB : similarity_search(embedding(question))\nVectorDB --&gt; ChatSvc : top-k chunks liên quan\\n(document_page_id, score)\n\nChatSvc -&gt; Redis : kiểm tra rate-limit token\nalt còn quota\n  ChatSvc -&gt; Gemini : generate(prompt = question + context)\n  Gemini --&gt; ChatSvc : answer text\nelse hết quota tức thời\n  ChatSvc -&gt; MQ : enqueue \&quot;chat.request\&quot;\\n{session_id, question, context}\n  MQ -&gt; ChatSvc : consume khi có slot (delay/backoff)\n  ChatSvc -&gt; Gemini : generate(prompt)\n  Gemini --&gt; ChatSvc : answer text\nend\n\nChatSvc -&gt; ChatSvc : build sources_json\\n[{document_id, page_number, score}]\nChatSvc -&gt; PG : INSERT Chat_Messages\\n(role=&#39;assistant&#39;, content=answer,\\nsources_json)\n\nChatSvc --&gt; Client : 200 OK\\n{answer, sources: [...]}\nClient -&gt; User : Hiển thị câu trả lời\\n+ trích dẫn nguồn tài liệu\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="OTLHhvo7-aArHCVMQKP1-1">
