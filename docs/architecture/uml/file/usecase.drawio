        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml UseCase_Overview\nleft to right direction\nskinparam packageStyle rectangle\nskinparam actorStyle awesome\n\nactor \&quot;Khách / Sinh viên\\n(Guest)\&quot; as Guest\nactor \&quot;User đã xác thực\\n(Authenticated User)\&quot; as AuthUser\nactor \&quot;AI System\\n(Recommendation/RAG)\&quot; as AI\nactor \&quot;Admin / Moderator\&quot; as Admin\n\nGuest &lt;|-- AuthUser\n\nrectangle \&quot;Hệ thống Chia sẻ Tài liệu Học thuật Phi tập trung\&quot; {\n\n  package \&quot;1. Quản lý Tài liệu / Upload\&quot; {\n    usecase \&quot;Đăng ký / Đăng nhập\&quot; as UC1\n    usecase \&quot;Upload tài liệu (PDF)\&quot; as UC2\n    usecase \&quot;Chỉnh sửa metadata tài liệu\\n(môn học, khoa, tag)\&quot; as UC3\n    usecase \&quot;Xoá / Ẩn tài liệu của mình\&quot; as UC4\n    usecase \&quot;Tìm kiếm &amp; lọc tài liệu\&quot; as UC5\n    usecase \&quot;Xem trạng thái xử lý\\n(uploading/processing/done)\&quot; as UC6\n  }\n\n  package \&quot;2. Xem &amp; Tương tác PDF\&quot; {\n    usecase \&quot;Xem PDF trực tuyến (viewer)\&quot; as UC7\n    usecase \&quot;Highlight / Ghi chú trên PDF\&quot; as UC8\n    usecase \&quot;Like / Bookmark tài liệu\&quot; as UC9\n    usecase \&quot;Tải xuống tài liệu\&quot; as UC10\n    usecase \&quot;Đánh giá / Report tài liệu vi phạm\&quot; as UC11\n  }\n\n  package \&quot;3. Trợ lý RAG AI Chat\&quot; {\n    usecase \&quot;Tạo phiên chat mới với AI\&quot; as UC12\n    usecase \&quot;Đặt câu hỏi về nội dung tài liệu\&quot; as UC13\n    usecase \&quot;Nhận câu trả lời + nguồn trích dẫn (sources)\&quot; as UC14\n    usecase \&quot;Xem lại lịch sử chat\&quot; as UC15\n  }\n\n  package \&quot;4. Admin / Moderation\&quot; {\n    usecase \&quot;Duyệt tài liệu mới upload\&quot; as UC16\n    usecase \&quot;Quản lý User / Role / Permission\&quot; as UC17\n    usecase \&quot;Xử lý report vi phạm\&quot; as UC18\n    usecase \&quot;Xem thống kê hệ thống\\n(dashboard)\&quot; as UC19\n    usecase \&quot;Cấu hình Bandit / Recommendation\&quot; as UC20\n  }\n\n  usecase \&quot;Tính điểm gợi ý tài liệu\\n(Multi-Armed Bandit)\&quot; as UC21\n  usecase \&quot;Trích xuất Vector / Embedding\\n(cho tài liệu mới)\&quot; as UC22\n}\n\n&#39; ---- Guest ----\nGuest --&gt; UC1\nGuest --&gt; UC5\nGuest --&gt; UC7\n\n&#39; ---- Authenticated User ----\nAuthUser --&gt; UC2\nAuthUser --&gt; UC3\nAuthUser --&gt; UC4\nAuthUser --&gt; UC6\nAuthUser --&gt; UC8\nAuthUser --&gt; UC9\nAuthUser --&gt; UC10\nAuthUser --&gt; UC11\nAuthUser --&gt; UC12\nAuthUser --&gt; UC13\nAuthUser --&gt; UC15\n\nUC13 ..&gt; UC14 : &lt;&lt;include&gt;&gt;\nUC2 ..&gt; UC22 : &lt;&lt;include&gt;&gt;\nUC5 ..&gt; UC21 : &lt;&lt;extend&gt;&gt;\n\n&#39; ---- AI System ----\nAI --&gt; UC14\nAI --&gt; UC21\nAI --&gt; UC22\n\n&#39; ---- Admin ----\nAdmin --&gt; UC16\nAdmin --&gt; UC17\nAdmin --&gt; UC18\nAdmin --&gt; UC19\nAdmin --&gt; UC20\nAdmin --&gt; UC4\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hQtgNNf1Izmc2xzXnZ8b-1">
