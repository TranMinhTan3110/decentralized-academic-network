        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Sequence_Upload_Vector\nactor User\nparticipant \&quot;Next.js Client\&quot; as Client\nparticipant \&quot;API Gateway\&quot; as Gateway\nparticipant \&quot;Document Service\&quot; as DocSvc\nparticipant \&quot;IPFS/MinIO\&quot; as Storage\nqueue \&quot;RabbitMQ\&quot; as MQ\nparticipant \&quot;OCR/Chunking Worker\&quot; as OCRWorker\nparticipant \&quot;Embedding Worker\&quot; as EmbedWorker\nparticipant \&quot;Gemini API\&quot; as Gemini\ndatabase \&quot;PostgreSQL\&quot; as PG\ndatabase \&quot;Vector DB\&quot; as VectorDB\n\nUser -&gt; Client : Chọn file PDF &amp; Upload\nClient -&gt; Gateway : POST /documents (multipart)\nGateway -&gt; DocSvc : forward request (đã auth)\n\nDocSvc -&gt; Storage : Lưu file gốc\\n(pin CID / put object)\nStorage --&gt; DocSvc : storage_key / CID\n\nDocSvc -&gt; PG : INSERT Documents\\n(status = &#39;pending&#39;)\nDocSvc -&gt; MQ : publish \&quot;document.uploaded\&quot;\\n{document_id, storage_key}\nDocSvc --&gt; Client : 202 Accepted\\n(document_id, status=pending)\n\n== Xử lý bất đồng bộ ==\nMQ -&gt; OCRWorker : consume \&quot;document.uploaded\&quot;\nOCRWorker -&gt; Storage : Đọc file theo storage_key\nOCRWorker -&gt; OCRWorker : OCR + Chunking\\n(chia theo trang/đoạn văn)\nOCRWorker -&gt; PG : INSERT Document_Pages\\n(ocr_text theo từng trang)\nOCRWorker -&gt; PG : UPDATE Documents\\nstatus = &#39;processing&#39;\nOCRWorker -&gt; MQ : publish \&quot;page.extracted\&quot;\\n{document_id, page_ids[]}\n\nMQ -&gt; EmbedWorker : consume \&quot;page.extracted\&quot;\nloop mỗi chunk/page\n  EmbedWorker -&gt; Gemini : Embedding API\\n(qua rate-limit queue)\n  Gemini --&gt; EmbedWorker : vector[]\n  EmbedWorker -&gt; VectorDB : upsert vector\n  EmbedWorker -&gt; PG : INSERT Vector_Metadata\\n{document_page_id, embedding_ref_id}\nend\nEmbedWorker -&gt; PG : UPDATE Documents\\nstatus = &#39;published&#39;\n\n== Client polling / WebSocket ==\nClient -&gt; Gateway : GET /documents/{id}/status\nGateway -&gt; DocSvc : forward\nDocSvc -&gt; PG : SELECT status\nDocSvc --&gt; Client : status = &#39;published&#39;\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CwNQBfbXMnOglQyjbOZv-51">
